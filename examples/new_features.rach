# Tour of the modern Rach surface: helpers, control flow, loops, ASCII art.

rach greet(name):
    return ascii_banner(name)
end

write("/tmp/rach_new.txt", "demo")

if linux:
    run("uname -a")
else:
    run("uname -s")

if not windows:
    run("echo 'not on windows'")

for url in ["alpha", "beta", "gamma"]:
    write("/tmp/rach_loop.txt", url)

names = ["one", "two", "three"]
for n in names:
    run("echo hello")

ascii_banner("RACH")
ascii_box("hello world", title="info", style="rounded")
ascii_pyramid("X")

banner = greet("HI")
del("/tmp/rach_new.txt")
del("/tmp/rach_loop.txt")
